{
  "name": "@postman-cse/onboarding-aws-spec-discovery",
  "version": "2.0.0",
  "description": "Discover AWS-hosted API specs and hand the result to Postman API onboarding.",
  "type": "module",
  "main": "dist/index.cjs",
  "bin": {
    "postman-aws-spec-discovery": "dist/cli.cjs"
  },
  "files": [
    "action.yml",
    "dist",
    "README.md",
    "docs",
    "SECURITY.md",
    "SUPPORT.md",
    "RELEASE_POLICY.md"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "npm run typecheck && rm -rf dist && esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs && esbuild src/cli.ts --bundle --platform=node --target=node24 --format=cjs --banner:js='#!/usr/bin/env node' --outfile=dist/cli.cjs",
    "verify:dist": "npm run build && git diff --ignore-space-at-eol --text --exit-code -- dist",
    "docs:tables": "node scripts/render-action-tables.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:live:sns": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "github-action",
    "postman",
    "aws",
    "aws-api-gateway",
    "appsync",
    "eventbridge",
    "sns",
    "apigateway",
    "openapi",
    "api-onboarding"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@aws-sdk/client-api-gateway": "^3.1057.0",
    "@aws-sdk/client-apigatewayv2": "^3.1057.0",
    "@aws-sdk/client-appsync": "^3.1057.0",
    "@aws-sdk/client-bedrock-agent": "^3.1057.0",
    "@aws-sdk/client-cloudformation": "^3.1057.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1057.0",
    "@aws-sdk/client-eventbridge": "^3.1057.0",
    "@aws-sdk/client-glue": "^3.1057.0",
    "@aws-sdk/client-lambda": "^3.1057.0",
    "@aws-sdk/client-pipes": "^3.1057.0",
    "@aws-sdk/client-resource-groups-tagging-api": "^3.1057.0",
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/client-schemas": "^3.1057.0",
    "@aws-sdk/client-sfn": "^3.1057.0",
    "@aws-sdk/client-sns": "^3.1057.0",
    "@aws-sdk/client-ssm": "^3.1057.0",
    "@aws-sdk/client-sts": "^3.1057.0",
    "@aws-sdk/client-verifiedpermissions": "^3.1057.0",
    "@postman-cse/automation-telemetry-core": "^0.2.0",
    "@smithy/node-http-handler": "^4.7.5",
    "undici": "^6.24.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "undici": "^6.24.0",
    "picomatch": ">=4.0.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "esbuild": "0.28.1",
    "eslint": "^10.4.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/postman-cs/postman-aws-spec-discovery-action"
  },
  "engines": {
    "node": ">=24"
  }
}
