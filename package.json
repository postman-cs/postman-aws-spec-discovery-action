{
  "name": "@postman-cse/onboarding-aws-spec-discovery",
  "version": "0.6.0",
  "description": "Discover and export API specs from AWS services with zero-config auto-detection.",
  "type": "module",
  "main": "dist/index.cjs",
  "bin": {
    "postman-aws-spec-discovery": "dist/cli.cjs"
  },
  "scripts": {
    "build": "npm run typecheck && rm -rf dist && esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.cjs && esbuild src/cli.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/cli.cjs",
    "check:dist": "npm run build && git diff --exit-code -- dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "github-action",
    "postman",
    "aws",
    "apigateway",
    "openapi"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@aws-sdk/client-api-gateway": "^3.1014.0",
    "@aws-sdk/client-apigatewayv2": "^3.1014.0",
    "@aws-sdk/client-appsync": "^3.1015.0",
    "@aws-sdk/client-cloudformation": "^3.1015.0",
    "@aws-sdk/client-glue": "^3.1015.0",
    "@aws-sdk/client-resource-groups-tagging-api": "^3.1015.0",
    "@aws-sdk/client-schemas": "^3.1015.0",
    "@aws-sdk/client-ssm": "^3.1015.0",
    "@aws-sdk/client-sts": "^3.1014.0",
    "@smithy/node-http-handler": "^4.4.5"
  },
  "overrides": {
    "undici": "^6.24.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "yaml": "^2.8.2"
  }
}
