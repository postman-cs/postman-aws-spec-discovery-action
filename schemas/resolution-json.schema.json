{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postman-cs.github.io/postman-aws-spec-discovery-action/schemas/resolution-json.schema.json",
  "title": "ResolutionJson",
  "type": "object",
  "required": [
    "status",
    "sourceType",
    "serviceName",
    "confidence",
    "evidence"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "resolved",
        "unresolved"
      ]
    },
    "sourceType": {
      "type": "string",
      "enum": [
        "repo-spec",
        "gateway-export",
        "manual-review",
        "discover-many"
      ]
    },
    "serviceName": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0
    },
    "specPath": {
      "type": "string"
    },
    "gatewayId": {
      "type": "string"
    },
    "gatewayType": {
      "type": "string",
      "enum": [
        "REST",
        "HTTP"
      ]
    },
    "stage": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
