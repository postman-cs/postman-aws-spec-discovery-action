{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postman-cs.github.io/postman-aws-spec-discovery-action/schemas/resolution-json.schema.json",
  "title": "ResolutionJson",
  "type": "object",
  "required": [
    "status",
    "sourceType",
    "serviceName",
    "confidence",
    "evidence"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "resolved",
        "unresolved"
      ]
    },
    "sourceType": {
      "type": "string",
      "enum": [
        "repo-spec",
        "gateway-export",
        "appsync-schema",
        "eventbridge-schema",
        "cfn-embedded",
        "glue-schema",
        "sns-contract",
        "ssm-registry",
        "lambda-url-export",
        "manual-review",
        "discover-many"
      ]
    },
    "serviceName": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0
    },
    "specPath": {
      "type": "string"
    },
    "gatewayId": {
      "type": "string"
    },
    "gatewayType": {
      "type": "string",
      "enum": [
        "REST",
        "HTTP",
        "WEBSOCKET",
        "SNS",
        "LAMBDA_URL"
      ]
    },
    "providerType": {
      "type": "string",
      "enum": [
        "api-gateway",
        "appsync",
        "eventbridge-schemas",
        "cloudformation",
        "glue",
        "sns",
        "ssm",
        "lambda-url"
      ]
    },
    "specFormat": {
      "type": "string",
      "enum": [
        "openapi-yaml",
        "openapi-json",
        "graphql-sdl",
        "asyncapi-yaml",
        "asyncapi-json",
        "json-schema",
        "postman-collection",
        "smithy",
        "avro",
        "protobuf"
      ]
    },
    "stage": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
